generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  name      String?
}

model Vender {
  id          String   @id @default(cuid())
  vendorName  String   @unique
  vnCode      String
  totalQty    String
  products    String[]
  poDate     String @default("")
  pricePerNos String
  nameOfPerson String @default("")
  contactNumber String @default("")
  email        String @default("")
  address      String @default("")
  gstNumber   String @default("")
  createdAt   DateTime @default(now())
}

